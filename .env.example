# Local dev server loads .env; isolated SCOPEPAY_DB test servers do not.
# Keep mock unless sandbox credentials and test accounts are configured.
PAYPAL_MODE=mock
PORT=4177
# SCOPEPAY_DB=/absolute/path/to/demo.sqlite
# Local inference only. Install Ollama, then run: ollama pull qwen3:4b
AI_PROVIDER=ollama
OLLAMA_MODEL=qwen3:4b
# Server-only sandbox credentials used by npm run check:paypal:
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
PAYPAL_SANDBOX_SELLER_EMAIL=
PAYPAL_SANDBOX_BUYER_EMAIL=
